#!/bin/sh
[ -z "${IPKG_INSTROOT:-}" ] && [ "${N2S_INSTALLING_COMPACT:-0}" != 1 ] || exit 0
guard=/var/run/nfqws2-strategy-apk.lock
if [ -r "$guard" ] && read -r owner < "$guard" && [ "$owner" = "$PPID" ]; then
  flock -n "$guard" true || exit 0
fi
[ "${PKG_UPGRADE:-0}" != 1 ] || exit 0
[ "${1:-}" != upgrade ] && [ "${2:-}" != upgrade ] || exit 0
[ "$(readlink /usr/bin/n2s)" = /usr/lib/nfqws2-strategy/n2s-compact ] || exit 0
N2S_COMPACT_PRERM=1 sh /usr/lib/nfqws2-strategy/uninstall.sh
