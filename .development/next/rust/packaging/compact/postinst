#!/bin/sh
# The unified installer activates the package on first install. Subsequent
# direct opkg upgrades should restart an already running compact service.
set -eu
[ -z "${IPKG_INSTROOT:-}" ] && [ "${N2S_INSTALLING_COMPACT:-0}" != 1 ] || exit 0
[ "$(readlink /opt/usr/bin/n2s)" = /opt/lib/nfqws2-strategy/n2s-compact ] || exit 0
init=/opt/etc/init.d/S52nfqws2-strategy
[ -x "$init" ] && [ "$("$init" status)" = running ] || exit 0
"$init" restart
